# ==============================================================================
# VESPER Environment Configuration
# ==============================================================================

# Server & Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Service Discovery & IPC URLs (Local or Distributed)
AGENT_SERVICE_URL=http://localhost:8001
VOICE_SERVICE_URL=http://localhost:8002
VISION_SERVICE_URL=http://localhost:8003
SYNC_SERVICE_URL=http://localhost:8004

# Supabase (Cloud PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Cloud AI Providers
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_API_KEY3=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AGENT_FAST_MODEL=groq/compound-mini
AGENT_PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Speech Providers (Google Cloud / Azure / ElevenLabs)
GOOGLE_CLOUD_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback
TAVILY_API_KEY=
