[Unit]
Description=VESPER Voice Pipeline Service (Piper TTS / Whisper / Wake Word)
After=network.target vesper-gateway.service
Wants=vesper-gateway.service
PartOf=vesper.target

[Service]
Type=simple
WorkingDirectory=/home/mihir/Codes/VESPER
ExecStart=/home/mihir/Codes/VESPER/.venv/bin/python3 -m uvicorn backend.voice.app:app --host 0.0.0.0 --port 8002
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
